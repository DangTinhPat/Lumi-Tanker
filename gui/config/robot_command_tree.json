{
  "schema": "tap.robot_command_tree.v1",
  "tool": "execute_robot_command",
  "envelope": {
    "command_id": "cmd_xxx",
    "source": "manual_ui | luvox | system",
    "action": "move | turn | set_height | emergency_stop",
    "args": {}
  },
  "priority_tree": [
    {"level": 3, "name": "safety", "commands": ["emergency_stop"], "policy": "override_all"},
    {"level": 1, "name": "basic_motion", "commands": ["move", "turn", "set_height"], "policy": "replace_same_level_no_queue"}
  ],
  "scheduler_rules": [
    "no_long_queue",
    "level_3_cancels_all",
    "level_1_commands_replace_each_other"
  ],
  "commands": {
    "move": {
      "level": 1,
      "description": "Tiến/lùi một khoảng cách.",
      "required": ["direction"],
      "params": {
        "direction": {"type": "string", "enum": ["forward", "backward"]},
        "distance_m": {"type": "number", "default": 1.0, "min": 0.0, "max": 10.0},
        "speed_mps": {"type": "number", "default": 0.2, "min": 0.01, "max": 1.0},
        "reason": {"type": "string", "default": ""}
      },
      "derived": {"duration_s": "distance_m / speed_mps"},
      "hardware_api_hint": "move_linear(direction, distance_m, speed_mps)"
    },
    "turn": {
      "level": 1,
      "description": "Quay trái/phải một góc.",
      "required": ["direction"],
      "params": {
        "direction": {"type": "string", "enum": ["left", "right"]},
        "angle_deg": {"type": "number", "default": 90.0, "min": 0.0, "max": 360.0},
        "speed_dps": {"type": "number", "default": 45.0, "min": 1.0, "max": 180.0},
        "reason": {"type": "string", "default": ""}
      },
      "derived": {"duration_s": "angle_deg / speed_dps"},
      "hardware_api_hint": "turn_yaw(direction, angle_deg, speed_dps)"
    },
    "set_height": {
      "level": 1,
      "description": "Đổi chiều cao thân robot.",
      "required": [],
      "params": {
        "height_m": {"type": "number", "default": null, "min": 0.078, "max": 0.1886},
        "direction": {"type": "string", "enum": ["up", "down"], "default": null},
        "delta_m": {"type": "number", "default": 0.02, "min": 0.0, "max": 0.08},
        "reason": {"type": "string", "default": ""}
      },
      "mode": {"absolute": "use height_m", "relative": "use direction + delta_m"},
      "hardware_api_hint": "set_body_height(height_m) or change_body_height(delta_m)"
    },
    "emergency_stop": {
      "level": 3,
      "description": "Dừng khẩn cấp, hủy mọi lệnh/mode đang chạy.",
      "required": [],
      "params": {"reason": {"type": "string", "default": "requested"}},
      "hardware_api_hint": "emergency_stop(reason)"
    }
  },
  "status": ["accepted", "running", "active", "completed", "cancelled", "blocked", "rejected"]
}
