build/
log/
__pycache__/

# Hidden files and directories (.claude, .vscode, .pio, .local ...)
.*
!.gitignore

# Local credentials: never committed
include/gateway/WifiSecrets.hpp
include/gateway/OtaSecrets.hpp
include/gateway/HcrWifiSecrets.hpp
.local/hybrid_ota.json

# Firmware binaries in reports/ embed the Wi-Fi password and the OTA key hash
# they were built with. Keep them local; never commit them.
reports/**/*.bin
reports/**/*.elf
reports/**/*.map
reports/**/*.ota.json
