Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 45; 48; 52
    Fixed Frame: cad_ground
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 0.05
      Plane Cell Count: 20
      Color: 100; 105; 110
    - Class: rviz_default_plugins/RobotModel
      Name: CAD Robot - 6 DOF
      Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /cad_preview/robot_description
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        History Policy: Keep Last
        Depth: 1
      Visual Enabled: true
      Collision Enabled: false
      Alpha: 1
    - Class: rviz_default_plugins/TF
      Name: Joint Frames
      Enabled: false
      Show Names: true
      Show Axes: true
      Show Arrows: false
      Marker Scale: 0.12
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 0.95
      Focal Point:
        X: 0
        Y: 0
        Z: 0.16
      Pitch: 0.32
      Yaw: 0.72
      Target Frame: cad_ground
Window Geometry:
  Width: 1150
  Height: 800
