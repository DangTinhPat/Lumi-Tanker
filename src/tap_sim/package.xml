<?xml version="1.0"?>
<package format="3">
  <name>tap_sim</name><version>0.1.0</version>
  <description>Gazebo simulation and gated bringup for the TAP CAD robot.</description>
  <maintainer email="user@example.com">Local Developer</maintainer><license>Proprietary</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <exec_depend>tap_robot_description</exec_depend>
  <exec_depend>tap_control</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend><exec_depend>ros_gz_bridge</exec_depend>
  <depend>gz_ros2_control</depend>
  <depend>pluginlib</depend><depend>hardware_interface</depend><depend>rclcpp</depend>
  <depend>gz-sim8</depend>
  <depend>gz-plugin2</depend><depend>gz-transport13</depend>
