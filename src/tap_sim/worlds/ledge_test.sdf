<?xml version="1.0"?>
<sdf version="1.9">
  <world name="empty">
    <!-- Deliberately minimal: ground_plane (identical to empty.sdf) plus one
         static 20 cm ledge_pad and nothing else. rough_training.sdf's own
         heightfield starts only 0.10 m past its spawn pad's edge, which
         confounded earlier landing tests -- a robot driven off that pad
         lands on the heightfield almost immediately (own ride height ~0.23 m
         above the heightfield's own ~0 m surface) rather than free-falling
         the intended 0.20 m to open ground, so what looked like "landing
         failure" was actually "loses balance while driving fast over rough
         terrain", a different problem (see docs/LEDGE_DRIVEOFF_LIMIT.md).
         This world isolates the actual touchdown/landing-impact question:
         drive off ledge_pad's edge and free-fall the full 0.20 m onto flat
         open ground_plane, nothing else nearby to confound the result. -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster">
      <dynamic_pose_hertz>250</dynamic_pose_hertz>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-apply-link-wrench-system" name="gz::sim::systems::ApplyLinkWrench"/>
    <!-- Loading this is inert unless the robot model also has contact
         sensors (opt-in via sim.launch.py's measure_contacts:=true); it
         only lets ContactSensorData populate when something asks for it. -->
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>
    <gravity>0 0 -9.81</gravity>
    <physics name="default_physics" type="ignored">
      <max_step_size>0.001</max_step_size><real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
      <dart><collision_detector>bullet</collision_detector><solver><solver_type>dantzig</solver_type></solver></dart>
    </physics>
    <light name="sun" type="directional">
      <pose>0 0 10 0 0 0</pose><diffuse>0.8 0.8 0.8 1</diffuse>
      <direction>-0.5 0.1 -0.9</direction><cast_shadows>true</cast_shadows>
    </light>
    <model name="ground_plane">
      <static>true</static>
      <link name="ground">
        <collision name="floor">
          <pose>0 0 -0.5 0 0 0</pose><geometry><box><size>20 20 1</size></box></geometry>
          <surface><friction><ode><mu>1</mu><mu2>1</mu2></ode></friction></surface>
        </collision>
        <visual name="floor">
          <pose>0 0 -0.5 0 0 0</pose><geometry><box><size>20 20 1</size></box></geometry>
          <material><ambient>0.55 0.55 0.55 1</ambient><diffuse>0.55 0.55 0.55 1</diffuse></material>
        </visual>
      </link>
    </model>
    <!-- Top z=0.20 (0.9x0.9 footprint, size.z=0.22 with pose z=0.09 so the
         bottom at -0.02 solidly overlaps ground_plane's top at z=0 -- no
         floating-collision gap, see rough_training.sdf's own fixed bug for
         why that matters). Robot spawns centered on top; driving +X (or any
         direction) off the edge at x=+/-0.45 free-falls the full 0.20 m onto
         open ground_plane with nothing else nearby. -->
    <model name="ledge_pad">
      <static>true</static>
      <pose>0 0 0.09 0 0 0</pose>
      <link name="pad">
        <collision name="c"><geometry><box><size>0.9 0.9 0.22</size></box></geometry>
          <surface><friction><ode><mu>1.35</mu><mu2>0.08</mu2></ode></friction></surface></collision>
        <visual name="v"><geometry><box><size>0.9 0.9 0.22</size></box></geometry>
          <material><ambient>0.30 0.42 0.52 1</ambient><diffuse>0.30 0.42 0.52 1</diffuse></material></visual>
      </link>
    </model>
    <!-- Quarter-round fillet on the +X departure edge only (the direction
         tools/clean_ledge_smoke.py drives off). Measured evidence (8 trials,
         see docs/LEDGE_DRIVEOFF_LIMIT.md): failing trials showed peak pitch
         RATE ~8.7-9.5 rad/s, almost exactly double the ~4.2-4.5 rad/s of
         recovered trials -- a signature of the wheel momentarily catching
         the sharp 90-degree box corner on departure (an added rotational
         impulse from a fulcrum at the corner), not a control/tuning
         difference. Radius 0.03 m (matching the wheel radius,
         src/tap_sim/CONTRACT.md) measurably reduced but did not eliminate
         the failure rate (5/8 fail with a sharp corner -> 1/8 fail with this
         fillet, one batch each). A larger 0.05 m radius was also tried and
         did NOT do better (3/8 fail) -- with only 8-trial batches this could
         be sampling noise rather than a real radius effect either way; do
         not read too much into small deltas here without a bigger n. Center
         at (edge_x - r, edge_z - r) makes the cylinder
         surface exactly tangent to both the pad's top face (z=0.20) and
         front face (x=0.45) - a true fillet, not an approximation, so there
         is no residual seam/lip. Axis along Y (roll=pi/2) so the round spans
         the full pad width. -->
    <model name="ledge_pad_departure_fillet">
      <static>true</static>
      <pose>0.42 0 0.17 1.5707963 0 0</pose>
      <link name="fillet">
        <collision name="c"><geometry><cylinder><radius>0.03</radius><length>0.96</length></cylinder></geometry>
          <surface><friction><ode><mu>1.35</mu><mu2>0.08</mu2></ode></friction></surface></collision>
        <visual name="v"><geometry><cylinder><radius>0.03</radius><length>0.96</length></cylinder></geometry>
          <material><ambient>0.30 0.42 0.52 1</ambient><diffuse>0.30 0.42 0.52 1</diffuse></material></visual>
      </link>
    </model>
  </world>
</sdf>
