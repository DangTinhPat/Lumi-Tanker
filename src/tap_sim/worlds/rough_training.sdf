<?xml version="1.0"?>
<!--
  Ported 1:1 (same tile/step/heightfield dimensions and positions) from the
  MuJoCo scene generated by /home/dvt/rl-basic/scripts/open_rough_mujoco_map.py
  (build_scene()/write_parabolic_hfield()): a smooth uneven heightfield arena
  on the left, a stepped/staircase arena on the right, a divider between them,
  and two scale-reference props. World name stays "empty" to match every
  other TAP world (bridges, activate_controllers, sim.launch.py spawn/bridge
  topics all hardcode /world/empty/...).

  Simplification versus the MuJoCo source: the 14x16 grid of individual
  0.26 m step tiles is merged into 8 full-width bands (one box per band,
  since every tile within a band shares the same height and color) --
  physically and visually identical (no gaps between the original tiles
  either), far fewer collision shapes.

  The MuJoCo scene's checker ground texture and exact positional point
  lights are approximated (flat ground color; two directional lights using
  the same directions/colors) since SDF/gz-sim conventions differ; every
  size, position and mass number below is copied unchanged from the source.
-->
<sdf version="1.9">
  <world name="empty">
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster">
      <dynamic_pose_hertz>250</dynamic_pose_hertz>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-apply-link-wrench-system" name="gz::sim::systems::ApplyLinkWrench"/>
    <!-- Required now that the default pitch_source is IMU-based
         (docs/RULES.md Rule 1): floor_contact then comes from real wheel
         contact sensing (measure_contacts:=true, on by default), not a
         pose heuristic. Inert unless something asks for ContactSensorData. -->
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>
    <gravity>0 0 -9.81</gravity>
    <physics name="default_physics" type="ignored">
      <max_step_size>0.001</max_step_size><real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
      <dart><collision_detector>bullet</collision_detector><solver><solver_type>dantzig</solver_type></solver></dart>
    </physics>

    <!-- rl-basic: light pos="0 -5 6" dir="0 1 -1" diffuse="0.9 0.9 0.86" -->
    <light name="sun" type="directional">
      <pose>0 -5 6 0 0 0</pose><diffuse>0.9 0.9 0.86 1</diffuse>
      <direction>0 1 -1</direction><cast_shadows>true</cast_shadows>
    </light>
    <!-- rl-basic: light pos="-4 2 5" dir="1 -0.2 -1" diffuse="0.35 0.38 0.45" -->
    <light name="fill" type="directional">
      <pose>-4 2 5 0 0 0</pose><diffuse>0.35 0.38 0.45 1</diffuse>
      <direction>1 -0.2 -1</direction><cast_shadows>false</cast_shadows>
    </light>

    <!-- rl-basic base_plane: size="8 6 0.05" (half-extents) pos="0 0 -0.055" -->
    <model name="ground_plane">
      <static>true</static>
      <link name="ground">
        <collision name="floor">
          <pose>0 0 -0.055 0 0 0</pose><geometry><box><size>16 12 0.10</size></box></geometry>
          <surface><friction><ode><mu>1.2</mu><mu2>0.08</mu2></ode></friction></surface>
        </collision>
        <visual name="floor">
          <pose>0 0 -0.055 0 0 0</pose><geometry><box><size>16 12 0.10</size></box></geometry>
          <material><ambient>0.21 0.225 0.20 1</ambient><diffuse>0.21 0.225 0.20 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- rl-basic parabolic_uneven_arena: hfield size="1.9 2.2 0.10 0.02" (half_x half_y elevation_z base_z)
         pos="-2.15 0 -0.05" -> full footprint 3.8 x 4.4, height range -0.05..+0.05 -->
    <model name="parabolic_uneven_arena">
      <static>true</static>
      <pose>-2.15 0 -0.05 0 0 0</pose>
      <link name="terrain">
        <collision name="terrain_collision">
          <geometry>
            <heightmap>
              <uri>media/parabolic_uneven_field.png</uri>
              <size>3.8 4.4 0.10</size>
              <pos>0 0 0</pos>
            </heightmap>
          </geometry>
          <surface><friction><ode><mu>1.35</mu><mu2>0.08</mu2></ode></friction></surface>
        </collision>
        <!-- A heightmap <visual> with a plain <material> and no <texture> layer
             crashed Gazebo's Ogre2 renderer here (Fragment Program ..._ps failed
             to compile): gz-sim's stock worlds/heightmap.sdf example (fetched
             Fuel model "Heightmap Bowl") always pairs <heightmap> visuals with
             at least one <texture> layer and never a <material>; this one-layer
             solid-color texture (rgb 92,122,110 = rl-basic's ambient 0.36 0.48
             0.43) plus a flat normal map (copied from that same working example)
             reproduces the intended flat tint through the proven code path. -->
        <visual name="terrain_visual">
          <geometry>
            <heightmap>
              <uri>media/parabolic_uneven_field.png</uri>
              <size>3.8 4.4 0.10</size>
              <pos>0 0 0</pos>
              <texture>
                <diffuse>media/rough_terrain_diffuse.png</diffuse>
                <normal>media/flat_normal.png</normal>
                <size>4</size>
              </texture>
            </heightmap>
          </geometry>
        </visual>
      </link>
    </model>

    <!-- TAP addition, not in the rl-basic source: a small flat step so the robot
         can spawn and balance on flat ground, then be driven off the edge for a
         controlled, reproducible step-down test -- isolated from the heightfield's
         variable bump heights, which cannot give a known, repeatable drop. Top at
         z=0.20 (20 cm above the standard flat-ground reference other profiles
         spawn on; CONTRACT.md's wheel-ground height) -- raised from an initial
         5 cm at the user's explicit request, despite this now exceeding both the
         robot's own body height (~0.237 m) and its full-squat leg stroke
         (~0.034 m per docs/WHEEL_KINEMATICS.md): at this height the robot may
         simply fall/tip on landing regardless of leg damping tuning, which is
         itself a valid (if less diagnostic for damping specifically) result.
         Centered at (-4.6, 0), fully clear of the heightfield's own footprint (x
         edge at -4.05, so a 0.1 m gap) -- moved out of the rough arena rather than
         embedded in it, so stepping off it lands on the plain base_plane, not a
         bump. Driving +X from here crosses onto the heightfield a bit further on.
         See sim.launch.py's terrain-conditioned spawn_x/spawn_y/spawn_z defaults. -->
    <model name="rough_arena_spawn_pad">
      <static>true</static>
      <!-- Bug fixed here: raising the step from 5 cm to 20 cm only moved this
           pose, without re-extending the box's own thickness -- its bottom face
           stayed at the old top-5cm sizing (z=0.04), floating ~4.5 cm above the
           real ground (base_plane top z=-0.005) with an invisible collision
           underside in that gap: something could collide with the bottom of the
           box without any visible geometry there (felt as an invisible/ghost
           step). Bottom now extended to z=-0.02, solidly overlapping base_plane,
           same grounding convention as the step bands/divider elsewhere in this
           file. Top stays at 0.20 (unchanged, per size.z 0.22 with this pose). -->
      <pose>-4.6 0 0.09 0 0 0</pose>
      <link name="pad">
        <collision name="c"><geometry><box><size>0.9 0.9 0.22</size></box></geometry>
          <surface><friction><ode><mu>1.35</mu><mu2>0.08</mu2></ode></friction></surface></collision>
        <visual name="v"><geometry><box><size>0.9 0.9 0.22</size></box></geometry>
          <material><ambient>0.30 0.42 0.52 1</ambient><diffuse>0.30 0.42 0.52 1</diffuse></material></visual>
      </link>
    </model>

    <!-- rl-basic right arena: 14x16 grid of 0.26 m tiles, height/tint banded every
         2 rows (iy // 2). Merged per band: full band width = 14*0.26 = 3.64 m,
         band depth = 2*0.26 = 0.52 m, x-center = right_center_x = 2.15 for all bands.
         y-centers and step_profile/tint below are computed from the source formulas
         (y0 = -(16-1)*0.26/2 = -1.95; band center y = y0 + (2*band+0.5)*0.26;
         tint = 0.35 + band*0.035). -->
    <model name="step_band_0">
      <static>true</static>
      <pose>2.15 -1.82 0.025 0 0 0</pose>
      <link name="band">
        <collision name="c"><geometry><box><size>3.64 0.52 0.05</size></box></geometry>
          <surface><friction><ode><mu>1.4</mu><mu2>0.08</mu2></ode></friction></surface></collision>
        <visual name="v"><geometry><box><size>3.64 0.52 0.05</size></box></geometry>
          <material><ambient>0.350 0.322 0.259 1</ambient><diffuse>0.350 0.322 0.259 1</diffuse></material></visual>
      </link>
    </model>
    <model name="step_band_1">
      <static>true</static>
      <pose>2.15 -1.30 0.030 0 0 0</pose>
      <link name="band">
        <collision name="c"><geometry><box><size>3.64 0.52 0.06</size></box></geometry>
          <surface><friction><ode><mu>1.4</mu><mu2>0.08</mu2></ode></friction></surface></collision>
        <visual name="v"><geometry><box><size>3.64 0.52 0.06</size></box></geometry>
          <material><ambient>0.385 0.354 0.285 1</ambient><diffuse>0.385 0.354 0.285 1</diffuse></material></visual>
      </link>
    </model>
    <model name="step_band_2">
      <static>true</static>
      <pose>2.15 -0.78 0.035 0 0 0</pose>
      <link name="band">
        <collision name="c"><geometry><box><size>3.64 0.52 0.07</size></box></geometry>
          <surface><friction><ode><mu>1.4</mu><mu2>0.08</mu2></ode></friction></surface></collision>
        <visual name="v"><geometry><box><size>3.64 0.52 0.07</size></box></geometry>
          <material><ambient>0.420 0.386 0.311 1</ambient><diffuse>0.420 0.386 0.311 1</diffuse></material></visual>
      </link>
    </model>
    <model name="step_band_3">
      <static>true</static>
      <pose>2.15 -0.26 0.040 0 0 0</pose>
      <link name="band">
        <collision name="c"><geometry><box><size>3.64 0.52 0.08</size></box></geometry>
          <surface><friction><ode><mu>1.4</mu><mu2>0.08</mu2></ode></friction></surface></collision>
        <visual name="v"><geometry><box><size>3.64 0.52 0.08</size></box></geometry>
          <material><ambient>0.455 0.419 0.337 1</ambient><diffuse>0.455 0.419 0.337 1</diffuse></material></visual>
      </link>
    </model>
    <model name="step_band_4">
      <static>true</static>
      <pose>2.15 0.26 0.050 0 0 0</pose>
      <link name="band">
        <collision name="c"><geometry><box><size>3.64 0.52 0.10</size></box></geometry>
          <surface><friction><ode><mu>1.4</mu><mu2>0.08</mu2></ode></friction></surface></collision>
        <visual name="v"><geometry><box><size>3.64 0.52 0.10</size></box></geometry>
          <material><ambient>0.490 0.451 0.363 1</ambient><diffuse>0.490 0.451 0.363 1</diffuse></material></visual>
      </link>
    </model>
    <model name="step_band_5">
      <static>true</static>
      <pose>2.15 0.78 0.045 0 0 0</pose>
      <link name="band">
        <collision name="c"><geometry><box><size>3.64 0.52 0.09</size></box></geometry>
          <surface><friction><ode><mu>1.4</mu><mu2>0.08</mu2></ode></friction></surface></collision>
        <visual name="v"><geometry><box><size>3.64 0.52 0.09</size></box></geometry>
          <material><ambient>0.525 0.483 0.389 1</ambient><diffuse>0.525 0.483 0.389 1</diffuse></material></visual>
      </link>
    </model>
    <model name="step_band_6">
      <static>true</static>
      <pose>2.15 1.30 0.0375 0 0 0</pose>
      <link name="band">
        <collision name="c"><geometry><box><size>3.64 0.52 0.075</size></box></geometry>
          <surface><friction><ode><mu>1.4</mu><mu2>0.08</mu2></ode></friction></surface></collision>
        <visual name="v"><geometry><box><size>3.64 0.52 0.075</size></box></geometry>
          <material><ambient>0.560 0.515 0.414 1</ambient><diffuse>0.560 0.515 0.414 1</diffuse></material></visual>
      </link>
    </model>
    <model name="step_band_7">
      <static>true</static>
      <pose>2.15 1.82 0.030 0 0 0</pose>
      <link name="band">
        <collision name="c"><geometry><box><size>3.64 0.52 0.06</size></box></geometry>
          <surface><friction><ode><mu>1.4</mu><mu2>0.08</mu2></ode></friction></surface></collision>
        <visual name="v"><geometry><box><size>3.64 0.52 0.06</size></box></geometry>
          <material><ambient>0.595 0.547 0.440 1</ambient><diffuse>0.595 0.547 0.440 1</diffuse></material></visual>
      </link>
    </model>

    <!-- rl-basic arena_divider: size="0.08 2.35 0.018" (half-extents) pos="0 0 0.018" -->
    <model name="arena_divider">
      <static>true</static>
      <pose>0 0 0.018 0 0 0</pose>
      <link name="divider">
        <collision name="c"><geometry><box><size>0.16 4.70 0.036</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.16 4.70 0.036</size></box></geometry>
          <material><ambient>0.08 0.09 0.09 1</ambient><diffuse>0.08 0.09 0.09 1</diffuse></material></visual>
      </link>
    </model>

    <!-- rl-basic scale_ball: pos="-3.75 -1.9 0.12", sphere radius 0.055, mass 1.5,
         friction "1.2 0.05 0.02"; freejoint -> non-static model here. -->
    <model name="scale_ball">
      <pose>-3.75 -1.9 0.12 0 0 0</pose>
      <link name="ball">
        <inertial>
          <mass>1.5</mass>
          <inertia><ixx>0.001815</ixx><iyy>0.001815</iyy><izz>0.001815</izz>
                   <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
        <collision name="c"><geometry><sphere><radius>0.055</radius></sphere></geometry>
          <surface><friction><ode><mu>1.2</mu><mu2>0.05</mu2></ode></friction></surface></collision>
        <visual name="v"><geometry><sphere><radius>0.055</radius></sphere></geometry>
          <material><ambient>0.85 0.10 0.08 1</ambient><diffuse>0.85 0.10 0.08 1</diffuse></material></visual>
      </link>
    </model>

    <!-- rl-basic robot_size_marker: pos="-3.95 -1.6 0.15", box half-size 0.09 0.09 0.15,
         contype/conaffinity 0 -> visual only, no collision. -->
    <model name="robot_size_marker">
      <static>true</static>
      <pose>-3.95 -1.6 0.15 0 0 0</pose>
      <link name="marker">
        <visual name="v"><geometry><box><size>0.18 0.18 0.30</size></box></geometry>
          <material><ambient>0.08 0.32 0.85 0.55</ambient><diffuse>0.08 0.32 0.85 0.55</diffuse></material></visual>
      </link>
    </model>
  </world>
</sdf>
